{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "iOS Simulator",
        "type": "node-terminal",
        "request": "launch",
        "command": "npx react-native run-ios --simulator \"iPhone 16\" --no-packager"
      },
      {
        "name": "iOS Device",
        "type": "node-terminal",
        "request": "launch",
        "command": "npx react-native run-ios --udid 00008101-00012D023E99001E --no-packager --extra-params \"-allowProvisioningUpdates\""
      }
    ],
    "compounds": [
      {
        "name": "iOS Sim + Device",
        "configurations": ["iOS Simulator", "iOS Device"]
      }
    ]
  }